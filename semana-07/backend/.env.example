# File Path: ./semana-07/backend/.env.example
NODE_ENV=development
PORT=3002
MONGO_URI=mongodb://hotel:hotel@localhost:27019/hotel_db?authSource=admin

# Genera cada secret con: openssl rand -base64 64
# PowerShell equivalente: [Convert]::ToBase64String((1..64 | %{Get-Random -Max 256}))
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie flags
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax